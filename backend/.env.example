# Gemini AI
# Optional. If omitted, the application uses the deterministic
# spaCy/regex parser as a fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Database
# Leave empty for the local SQLite configuration.
# For deployment, provide a PostgreSQL connection string (e.g. Neon).
DATABASE_URL=

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
BREVO_SENDER_NAME=Personal Task Assistant

# Google Calendar
# Google Calendar integration is optional.
# Configure the required Google OAuth credentials separately if used.

JWT_SECRET_KEY=your_long_random_secret_here